# Variables necesarias para la pagina /acceso.
# Copia a .env.local y rellena. Ver github.com/astillero-dev para el contexto.
#
# En produccion van en Vercel: Settings > Environment Variables.
# Ninguna lleva NEXT_PUBLIC_: ese prefijo las enviaria al navegador, y el
# token de administracion ahi seria regalar el control de la organizacion.

# OAuth App: Settings > Developer settings > OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Token clasico con permiso admin:org y sin caducidad
GITHUB_ADMIN_TOKEN=

GITHUB_ORG=
GITHUB_TEAM=